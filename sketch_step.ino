  /*Serial.print(analogRead(xSig));
  Serial.print(" ");
  Serial.print(analogRead(ySig));
  Serial.print(" ");
  Serial.println(analogRead(zSig));
  */
  
  int data = sqrt((analogRead(xSig)^2) + (analogRead(ySig)^2) + (analogRead(zSig)^2));
  //int data = (abs(analogRead(xSig)) + abs(analogRead(ySig)) + abs(analogRead(zSig)));
  
  //Serial.print("data: "); Serial.println(data);
  data = calibration(data);
  //delay(10);
  timef = millis();
  if(data > 0) {
    stepCountMill = millis();
    check = true;
    //Serial.println("high");
  }
  if(check == true) {
    //Serial.println(data);
    if(data < -1) {
      if(counting){
        lowCountMill = millis();
        currentSteps ++;
        Serial.print("steps: "); Serial.println(currentSteps);
        
        //tft.fillScreen(GC9A01A_BLACK);
        
        if(paces != 3) {
        tft.fillRect(x, y, w, h, GC9A01A_BLACK);

        tft.setTextColor(GC9A01A_RED);
        tft.setTextSize(4);
        tft.setCursor(95, 180);
        tft.print(currentSteps);
        tft.setTextSize(2);
        tft.setCursor(70, 210);
        tft.print(pace); 

        drawCircularProgress(currentSteps);
        }
      }
      else{
        possMill = millis();
        possibleSteps ++;
        Serial.print("possible steps: "); Serial.println(possibleSteps);
      }
      check = false;
    }
  }
  if(timef - stepCountMill > 300) {
    check = false;
  }
  if(timef - lowCountMill > 2000 && counting == true) {
    counting = false;
    possibleSteps = 0;
    Serial.println("beans");
  }
  if(possibleSteps > 7 && counting == false) {
    lowCountMill = millis();
    counting = true;
    currentSteps += possibleSteps;
    lastSteps += possibleSteps - 1;
    paces = 1;
  }
  if(timef - possMill > 2000 && counting == false){
    possibleSteps =0;
    //Serial.println("beansforfun");
  }
  //delay(100);

}

// ----------------------------------------------------
// CIRCULAR PROGRESS BAR
// ----------------------------------------------------
void drawCircularProgress(int steps) {
  int progress = constrain(steps, 0, 100);
  float percent = (float)progress / 100;
 
  int cx = 120;
  int cy = 120;
 
  int radius = 117;
  int thickness = 10;
 
  int endAngle = percent * 360;
 
  // Colour fades from yellow to red
  int red = 255;
  int green = 255 * (1.0 - percent);
  int blue = 0;
 
  uint16_t progressColor = tft.color565(red, green, blue);
  uint16_t backgroundRingColor = tft.color565(35, 35, 35);
 
  // Draw full dark ring behind progress
  for (int a = 0; a < 360; a++) {
    drawThickArcPixel(cx, cy, radius, thickness, a - 90, backgroundRingColor);
  }
 
  // Draw progress ring clockwise from top
  for (int a = 0; a < endAngle; a++) {
    drawThickArcPixel(cx, cy, radius, thickness, a - 90, progressColor);
  }
}
 
// ----------------------------------------------------
// DRAW THICK ARC PIXELS
// ----------------------------------------------------
void drawThickArcPixel(
  int cx,
  int cy,
  int radius,
  int thickness,
  int angleDeg,
  uint16_t color
) {
  float angleRad = angleDeg * DEG_TO_RAD;
 
  for (int r = radius - thickness + 1; r <= radius; r++) {
    int rx = cx + cos(angleRad) * r;
    int ry = cy + sin(angleRad) * r;
 
    if (rx >= 0 && rx < 240 && ry >= 0 && ry < 240) {
      tft.drawPixel(rx, ry, color);
    }
  }
}

int calibration(int mappedValue) {
  
  // Read button
  bool buttonState = digitalRead(buttonPin);
 
  // Calibration on press
  if (lastButtonState == HIGH && buttonState == LOW) {
    offset = mappedValue;
    currentSteps = 0;

    tft.fillRect(x, y, w, h, GC9A01A_BLACK);

    tft.setTextColor(GC9A01A_RED);
    tft.setTextSize(4);
    tft.setCursor(95, 170);
    tft.print(currentSteps);

    drawCircularProgress(currentSteps);
  }
 
  lastButtonState = buttonState;
 
  // Apply calibration
  calibratedValue = mappedValue - offset;
  Serial.print("calibrated: "); Serial.println(calibratedValue);
  return calibratedValue;
}


